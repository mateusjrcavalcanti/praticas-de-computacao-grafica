{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Site: desenvolvimento",
      "type": "shell",
      "command": "npm run dev",
      "windows": {
        "command": "npm.cmd run dev"
      },
      "options": {
        "cwd": "${workspaceFolder}/www"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Site: build Vite",
      "type": "shell",
      "command": "npm run build",
      "windows": {
        "command": "npm.cmd run build"
      },
      "options": {
        "cwd": "${workspaceFolder}/www"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "C++: build nativo",
      "type": "shell",
      "command": "npm run build:native",
      "windows": {
        "command": "npm.cmd run build:native"
      },
      "options": {
        "cwd": "${workspaceFolder}/www"
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}
